FROM node:20-alpine AS tool
RUN apk add --no-cache bash git curl unzip

FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /src
COPY pubspec.* ./
RUN flutter pub get
COPY . .
ARG API_BASE_URL
RUN flutter build web --dart-define=API_BASE_URL=${API_BASE_URL}

FROM nginx:alpine
COPY --from=build /src/build/web /usr/share/nginx/html
COPY deployments/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]


